			ShieldConduit: {
				DisplayName: 屏障脉管
				Tooltip:
					'''
					2 召唤标记伤害
					两种模式自动切换
					'''
				HoldShiftTooltip:
					'''
					-----------------------------
					防御模式：
					鞭子击中的敌人，
					仆从攻击其会释放短暂存在的蓝色护盾碎片
					收集碎片为护盾充能
					达到50点充能值后，激活50点HP的护盾
					获得护盾时进入攻击模式
					-----------------------------
					攻击模式：
					鞭子击中的敌人，
					仆从攻击其会释放短暂存在的红色护盾碎片
					其会追踪敌怪，造成仆从面板10%+3伤害
					-----------------------------
					护盾碎片的释放有短暂内置CD
					当护盾承受伤害时，会根据剩余护盾进入5-50秒的CD；
					若护盾完全碎裂，CD会变为60秒
					护盾冷却时，转到攻击模式；冷却结束，转到防御模式
					护盾存在时，收集护盾碎片可修复护盾耐久值
					'''
			}

